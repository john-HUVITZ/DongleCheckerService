<Window x:Class="DongleCheckTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DongleCheckTest" Height="520" Width="760"
        MinHeight="480" MinWidth="680">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="DongleChecker License Test"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="IP"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="IpTextBox"
                         Grid.Column="1"
                         Text="127.0.0.1"
                         MinWidth="180"
                         Height="28"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="Port"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <TextBox x:Name="PortTextBox"
                         Grid.Column="3"
                         Text="8082"
                         MinWidth="80"
                         Height="28"
                         VerticalContentAlignment="Center" />

                <Button x:Name="RequestButton"
                        Grid.Column="4"
                        Content="Call /license"
                        MinWidth="110"
                        Height="30"
                        Margin="16,0,0,0"
                        Click="RequestButton_Click" />

                <Button x:Name="StopServiceButton"
                        Grid.Column="5"
                        Content="Stop DongleCheckerSvc"
                        MinWidth="150"
                        Height="30"
                        Margin="8,0,0,0"
                        Click="StopServiceButton_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="0,12,0,8"
                   Text="IP와 Port를 입력한 후 Call /license를 누르세요."
                   Foreground="#555555" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="License Result">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="IsConn:" FontWeight="SemiBold" Margin="0,0,12,8" />
                    <TextBlock x:Name="IsConnTextBlock" Grid.Column="1" Text="-" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Text="Key:" FontWeight="SemiBold" Margin="0,0,12,8" />
                    <TextBlock x:Name="KeyTextBlock" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Text="SerialNumber:" FontWeight="SemiBold" Margin="0,0,12,8" />
                    <TextBlock x:Name="SerialNumberTextBlock" Grid.Row="2" Grid.Column="1" Text="-" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Text="Date:" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <TextBlock x:Name="DateTextBlock" Grid.Row="3" Grid.Column="1" Text="-" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Raw Response">
                <TextBox x:Name="RawResponseTextBox"
                         Margin="12"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="#777777"
                   Text="Request URL: http://{IP}:{Port}/license" />
    </Grid>
</Window>
